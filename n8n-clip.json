    {
      "parameters": {
        "jsCode": "const raw = $('AI Agent').item.json.output;\nconst moments = JSON.parse(raw.match(/\\[[\\s\\S]*\\]/)[0]);\nconst original_text = $('Telegram Trigger').item.json.message.text.trim();\nconst parts = original_text.split(' ');\n\n// Ekstrak URL, range, dan mode\nconst yt_url = parts[0];\nconst range = parts[1] && parts[1].includes('-') ? parts[1] : null;\nconst isGaming = original_text.toUpperCase().includes('GAMING');\nconst mode = isGaming ? \"gaming\" : \"normal\";\n\nlet msg = `🎬 *5 Momen Terbaik!*\\n`;\nmsg += `Mode: ${isGaming ? '🎮 Gaming (Facecam)' : '📺 Normal'}\\n`;\nmsg += range ? `⏰ Range: ${range}\\n\\n` : '\\n';\n\nmoments.forEach((m) => {\n  msg += `*${m.nomor}. Score: ${m.score}/100* 🔥\\n`;\n  msg += `⏱ ${m.start} - ${m.end}\\n`;\n  msg += `📝 ${m.alasan}\\n\\n`;\n});\nmsg += \"➡️ Ketik *1-5* untuk memilih!\";\n\nreturn [{ json: {\n  chat_id: $('Telegram Trigger').item.json.message.chat.id,\n  yt_url,\n  range,\n  mode,\n  message: msg,\n  moments\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        48
      ],
      "id": "86a48edc-a329-4fd5-9eaa-30598be1a4f4",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// User mengetik angka di form free text\nconst choice = parseInt($input.first().json.data.text);\nconst moments = $('Code in JavaScript').first().json.moments\nconst yt_url = $('Code in JavaScript').first().json.yt_url\n\nif (isNaN(choice) || choice < 1 || choice > 5) {\n  throw new Error(\"Pilihan tidak valid, harus angka 1-5\");\n}\n\nconst selected = moments[choice - 1];\n\nreturn [{\n  json: {\n    url: yt_url,\n    start: selected.start,\n    end: selected.end,\n    caption: selected.caption\n  }\n}];"
      },
